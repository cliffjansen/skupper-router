# rnew2l.conf

router {
    mode: interior
    id: router3
    workerThreads: 4
    transportPlugin: fooTransport
}

# Prevent flow logging affecting performance
log {
    module: FLOW_LOG
    enable: warning+
}

log {
    module: DEFAULT
    enable: info+
}

# For skstat
listener {
    host: 127.0.0.1
    port: 56722
    saslMechanisms: ANONYMOUS
}

tcpListener {
    address: flood/tcp
    host: 127.0.0.1
    port: 20001
}

